# Langflow with no automatic outbound calls. Copy to langflow.env, set the password, then:
#   langflow run --env-file langflow.env
# Verified on Langflow 1.12.5 (see README.md for what each line blocks and what still needs a firewall).
LANGFLOW_HOST=127.0.0.1
LANGFLOW_PORT=7860
LANGFLOW_CONFIG_DIR=./lfdata
LANGFLOW_SAVE_DB_IN_CONFIG_DIR=true
# Login on, one admin; new users start inactive until the admin enables them.
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=change-me-to-a-long-random-password
# Outbound switches: Scarf telemetry, legacy component store, models.dev catalog, LiteLLM price list.
LANGFLOW_DO_NOT_TRACK=true
DO_NOT_TRACK=true
LANGFLOW_STORE=false
LANGFLOW_MODELS_DEV_REFRESH=false
LITELLM_LOCAL_MODEL_COST_MAP=True
# Let flows call the local model server only (SSRF guard blocks loopback otherwise).
LANGFLOW_SSRF_ALLOWED_HOSTS=127.0.0.1
# Users' flows may not read arbitrary server files (keep true; the build-from-description
# assistant needs false on a pip install, see README).
LANGFLOW_RESTRICT_LOCAL_FILE_ACCESS=true
